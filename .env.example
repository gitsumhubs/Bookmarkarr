# Optional overrides for docker-compose.yml. The file runs without an .env file.
BOOKMARKARR_PORT=3018
BOOKMARKARR_PUBLIC_URL=http://localhost:3018

# Runtime identity and logging
PUID=1000
PGID=1000
UMASK=022
TZ=UTC
BOOKMARKARR_LOG_LEVEL=Information

# Authentication. Leave the API key empty to let Bookmarkarr create one in runtime config.
BOOKMARKARR_AUTHENTICATION_REQUIRED=false
BOOKMARKARR_API_KEY=

# Portable host mounts (relative defaults are suitable for a local checkout)
BOOKMARKARR_CONFIG_PATH=./data/config
BOOKMARKARR_AUDIOBOOKS_PATH=./data/audiobooks
BOOKMARKARR_EBOOKS_PATH=./data/ebooks
BOOKMARKARR_DOWNLOADS_PATH=./data/downloads

# Prowlarr's config directory, mounted so Settings > ABB Patch can install the paginated
# AudioBook Bay definition itself. Point this at Prowlarr's own config folder — the same one
# holding config.xml — then `docker compose up -d`. Left at the default it is an empty folder
# and the tab tells you so; the patch remains installable by hand either way.
BOOKMARKARR_PROWLARR_CONFIG_PATH=./data/prowlarr-config

# Separate download-client categories
BOOKMARKARR_AUDIOBOOK_CATEGORY=audiobooks
BOOKMARKARR_EBOOK_CATEGORY=ebooks

# Optional Docker networks for docker-compose.external-networks.example.yml.
# Copy that file without the .example suffix, remove unused networks, then uncomment COMPOSE_FILE.
PROWLARR_DOCKER_NETWORK=replace_with_prowlarr_network
NZBGET_DOCKER_NETWORK=replace_with_nzbget_network
RDTCLIENT_DOCKER_NETWORK=replace_with_rdtclient_network
# COMPOSE_FILE=docker-compose.yml:docker-compose.external-networks.yml

# Source developers only: local image override used with docker-compose.dev.yml.
BOOKMARKARR_DEV_IMAGE=bookmarkarr:local
